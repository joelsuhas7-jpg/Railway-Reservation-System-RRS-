# --- Runtime data written by the application (never commit) ---
# The app keeps its record files (users.dat, bookings.dat, ...) and audit.log
# in a data directory. Use /data/ for local runs. Committed test fixtures
# belong under tests/fixtures/ and are NOT ignored.
/data/
audit.log

