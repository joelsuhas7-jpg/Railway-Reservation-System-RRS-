file(GLOB_RECURSE RRS_PRODUCTION_FILES CONFIGURE_DEPENDS
     "${CMAKE_SOURCE_DIR}/src/*.cpp" "${CMAKE_SOURCE_DIR}/src/*.hpp")

set(RRS_PRODUCTION_STATEMENTS 0)
set(RRS_PLATFORM_STATEMENTS 0)
foreach(source_file IN LISTS RRS_PRODUCTION_FILES)
    file(RELATIVE_PATH relative_file "${CMAKE_SOURCE_DIR}" "${source_file}")
    file(STRINGS "${source_file}" source_lines)
    set(platform_depth 0)
    set(conditional_depth 0)
    foreach(line IN LISTS source_lines)
        if(NOT relative_file STREQUAL "src/platform_shim.cpp" AND
           line MATCHES "^[ \t]*#[ \t]*(if|ifdef|ifndef|elif).*(WIN32|unix|APPLE|linux|_MSC_VER|__GNUC__)")
            message(FATAL_ERROR
                    "Platform conditional outside src/platform_shim.cpp: ${relative_file}: ${line}")
        endif()

        if(relative_file STREQUAL "src/platform_shim.cpp")
            if(line MATCHES "^[ \t]*#[ \t]*(if|ifdef|ifndef)([ \t]|$)")
                math(EXPR conditional_depth "${conditional_depth} + 1")
                set(platform_conditional_${conditional_depth} FALSE)
                if(line MATCHES "(WIN32|unix|APPLE|linux|_MSC_VER|__GNUC__)")
                    set(platform_conditional_${conditional_depth} TRUE)
                    math(EXPR platform_depth "${platform_depth} + 1")
                endif()
            elseif(line MATCHES "^[ \t]*#[ \t]*endif")
                if(conditional_depth GREATER 0)
                    if(platform_conditional_${conditional_depth})
                        math(EXPR platform_depth "${platform_depth} - 1")
                    endif()
                    math(EXPR conditional_depth "${conditional_depth} - 1")
                endif()
            endif()
        endif()

        if(line MATCHES ";[ \t]*(//.*)?$")
            math(EXPR RRS_PRODUCTION_STATEMENTS "${RRS_PRODUCTION_STATEMENTS} + 1")
            if(platform_depth GREATER 0)
                math(EXPR RRS_PLATFORM_STATEMENTS "${RRS_PLATFORM_STATEMENTS} + 1")
            endif()
        endif()
    endforeach()
endforeach()

if(RRS_PRODUCTION_STATEMENTS GREATER 0)
    math(EXPR RRS_PLATFORM_PERCENT "${RRS_PLATFORM_STATEMENTS} * 100 / ${RRS_PRODUCTION_STATEMENTS}")
    math(EXPR RRS_PLATFORM_LIMIT "${RRS_PRODUCTION_STATEMENTS} * 2")
    math(EXPR RRS_PLATFORM_ACTUAL "${RRS_PLATFORM_STATEMENTS} * 100")
    if(RRS_PLATFORM_ACTUAL GREATER RRS_PLATFORM_LIMIT)
        message(FATAL_ERROR
                "Platform-dependent production statements exceed 2% (${RRS_PLATFORM_STATEMENTS}/${RRS_PRODUCTION_STATEMENTS})")
    endif()
    message(STATUS
            "Platform shim: ${RRS_PLATFORM_STATEMENTS}/${RRS_PRODUCTION_STATEMENTS} production statements (${RRS_PLATFORM_PERCENT}%, limit 2%)")
endif()
